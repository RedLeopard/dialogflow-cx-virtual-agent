{
  "name": "c8b17389-cc6b-5536-9ee3-78f0188580df",
  "displayName": "Callback Number",
  "entryFulfillment": {
    "webhook": "Project Discovery Backend",
    "tag": "offer-callback"
  },
  "transitionRoutes": [
    {
      "name": "e74d5478-104b-51cc-87f5-4d015ca09135",
      "condition": "$session.params.callback_candidate = null",
      "targetPage": "Alternate Number"
    },
    {
      "name": "5cfb454e-a647-5434-a7bd-08ae7bc338fd",
      "intent": "confirm.yes",
      "triggerFulfillment": {
        "setParameterActions": [
          {
            "parameter": "callback_number",
            "value": "$session.params.callback_candidate"
          }
        ]
      },
      "targetPage": "Consultation Request"
    },
    {
      "name": "8d805ad0-88a6-5a81-ada9-a96f94470375",
      "intent": "confirm.no",
      "targetPage": "Alternate Number"
    }
  ],
  "eventHandlers": [
    {
      "event": "sys.no-match-default",
      "triggerFulfillment": {
        "messages": [
          {
            "text": {
              "text": [
                "Just a yes or no is perfect."
              ]
            },
            "languageCode": "en"
          }
        ]
      },
      "name": "dc874d0e-4d62-5347-83a4-9de2bfec9b3b"
    }
  ]
}
