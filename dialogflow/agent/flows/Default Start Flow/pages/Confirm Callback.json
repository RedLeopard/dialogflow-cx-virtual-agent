{
  "name": "5da0b784-a8dc-551a-8741-a8e7a040d4ee",
  "displayName": "Confirm Callback",
  "transitionRoutes": [
    {
      "name": "f12a0de3-3161-5f19-96ff-8a9756a4423e",
      "intent": "confirm.yes",
      "triggerFulfillment": {
        "setParameterActions": [
          {
            "parameter": "callback_number",
            "value": "$session.params.callback_number_raw"
          }
        ]
      },
      "targetPage": "Consultation Request"
    },
    {
      "name": "c145e704-b877-5096-8bf0-c99ac6c86916",
      "intent": "confirm.no",
      "triggerFulfillment": {
        "messages": [
          {
            "text": {
              "text": [
                "Sorry, let's try again."
              ]
            },
            "languageCode": "en"
          }
        ],
        "setParameterActions": [
          {
            "parameter": "callback_number_raw",
            "value": null
          }
        ]
      },
      "targetPage": "Alternate Number"
    }
  ],
  "eventHandlers": [
    {
      "event": "sys.no-match-default",
      "triggerFulfillment": {
        "messages": [
          {
            "text": {
              "text": [
                "Just a yes or no is perfect."
              ]
            },
            "languageCode": "en"
          }
        ]
      },
      "name": "a081e356-a431-548f-bf13-c6031eb88382"
    }
  ]
}
